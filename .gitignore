# 默认全忽略，白名单放行
.DS_Store
/*
!/.gitignore
!/README.md
!/install.sh
!/agent/
!/tiers/
/agent/*
!/agent/config.yml
!/agent/models.yml
!/agent/keybindings.yml
!/agent/APPEND_SYSTEM.md
!/agent/.env.example
!/agent/mcp.json
!/agent/extensions/
# Orca 托管生成的扩展，勿提交（每次 Orca 更新都会重写）
/agent/extensions/orca-*.ts
!/agent/agents/
!/agent/commands/
!/agent/skills/

# 依赖目录一律忽略
node_modules/

# 插件还原要素(换机恢复用):市场源 + 已装清单 + 启用状态
!/marketplaces.json
!/plugins/
/plugins/*
!/plugins/installed_plugins.json
!/plugins/omp-plugins.lock.json